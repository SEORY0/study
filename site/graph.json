---
layout: null
permalink: /graph.json
sitemap: false
---
{%- comment -%}
  The whole study graph for the ring (site/assets/js/study-ring.js): areas,
  subjects, threads, every note in index order, and the links between
  notes. A link is any "/study/<slug>/" in a note's text that names
  another note. Each note's text is split on "/study/" once instead of
  testing every pair, so this stays linear in the size of the notes.
  A note's slug is its file name and its subject its folder:
  studies/<subject>/<slug>.md.
{%- endcomment -%}
{%- include ordered.html -%}
{%- capture gd_known -%},{%- for d in notes_in_order -%}{{ d.name | remove: ".md" }},{%- endfor -%}{%- endcapture -%}
{
"areas": [{%- for a in site.data.study.areas -%}{"id": {{ a.id | jsonify }}, "name": {{ a.name | jsonify }}, "en": {{ a.en | jsonify }}, "home": {% if a.home %}true{% else %}false{% endif %}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"subjects": [{%- for s in site.data.study.subjects -%}{"id": {{ s.id | jsonify }}, "area": {{ s.area | jsonify }}, "name": {{ s.name | jsonify }}, "en": {{ s.en | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"threads": [{%- for t in site.data.study.threads -%}{"id": {{ t.id | jsonify }}, "mark": {{ t.mark | jsonify }}, "name": {{ t.name | jsonify }}, "line": {{ t.line | jsonify }}}{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%}],
"notes": [
{%- for d in notes_in_order -%}
  {%- assign gd_parts = d.path | split: "/" -%}
  {%- assign gd_slug = d.name | remove: ".md" -%}
  {"slug": {{ gd_slug | jsonify }}, "subject": {{ gd_parts[1] | jsonify }}, "title": {{ d.title | jsonify }}, "short": {{ d.short | default: d.title | jsonify }}, "summary": {{ d.summary | jsonify }}, "threads": {% if d.threads %}{{ d.threads | jsonify }}{% else %}[]{% endif %}, "url": {{ d.url | relative_url | jsonify }}}
  {%- unless forloop.last -%},{%- endunless %}
{% endfor -%}
],
"links": [
{%- assign gd_first = true -%}
{%- for d in notes_in_order -%}
  {%- assign gd_slug = d.name | remove: ".md" -%}
  {%- assign gd_seen = "," -%}
  {%- assign gd_bits = d.content | split: "/study/" -%}
  {%- for gd_bit in gd_bits offset: 1 -%}
    {%- assign gd_to = gd_bit | split: "/" | first -%}
    {%- capture gd_key -%},{{ gd_to }},{%- endcapture -%}
    {%- if gd_to == gd_slug or gd_seen contains gd_key -%}{%- continue -%}{%- endif -%}
    {%- unless gd_known contains gd_key -%}{%- continue -%}{%- endunless -%}
    {%- assign gd_seen = gd_seen | append: gd_to | append: "," -%}
    {%- unless gd_first -%},{%- endunless -%}[{{ gd_slug | jsonify }}, {{ gd_to | jsonify }}]
    {%- assign gd_first = false -%}
  {%- endfor -%}
{%- endfor -%}
]
}
